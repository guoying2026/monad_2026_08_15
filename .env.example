# ── Network: testnet | mainnet ────────────────────────────────
MONAD_NETWORK=testnet

# ── RPC ───────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ── Wallet that receives x402 USDC (also used to register agent) ──
PAY_TO_ADDRESS=0xYourWallet
PRIVATE_KEY=

# ── ERC-8004 (filled automatically from network, override if needed) ──
# IDENTITY_REGISTRY=
# REPUTATION_REGISTRY=
AGENT_ID=
AGENT_URI=http://localhost:4000/.well-known/agent-card.json
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# ── x402 ──────────────────────────────────────────────────────
# Set true to skip payment while wiring scan/subscribe (stage 2)
SKIP_X402=true
X402_PRICE=$0.01
FACILITATOR_URL=https://x402-facilitator.molandak.org

# ── LLM（OpenAI 兼容接口，未配置时回退规则引擎）────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# ── Telegram (optional — logs alerts if missing) ──────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ── Email (optional — Resend; logs if missing) ────────────────
RESEND_API_KEY=
EMAIL_FROM=Pulse <onboarding@resend.dev>

# ── MySQL（订阅 / 通知持久化，刷新和重启都还在）──────────────
DATABASE_URL=mysql://root@127.0.0.1:3306/pulse

# ── Worker ────────────────────────────────────────────────────
POLL_INTERVAL_MS=20000
API_INTERNAL_URL=http://localhost:4000

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MONAD_NETWORK=testnet
NEXT_PUBLIC_AGENT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
